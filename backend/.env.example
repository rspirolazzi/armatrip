# Copiar a .env (o docker/preparar-entorno.ps1). Nunca versionar .env.
APP_NAME=Armatrip
APP_ENV=local
APP_KEY=
# true también habilita /sys-terminal: no usarlo fuera de un entorno local
APP_DEBUG=false
APP_URL=http://localhost:8085
APP_WEB_URL=http://localhost:3085
APP_URL_FIX_IMAGES=http://localhost:8085
APP_URL_STORAGE_IMAGES=/storage

JWT_SECRET=
# Duración de la sesión web en minutos
JWT_TTL=240
# Contraseña de los usuarios iniciales del panel; obligatoria para db:seed
SEED_USERS_PASSWORD=

LOG_CHANNEL=stack

# Valores para Docker
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=armatrip
DB_USERNAME=armatrip
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit: captura los emails sin enviarlos
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-responder@example.com
MAIL_FROM_NAME=Armatrip
MAIL_ADMIN_ADDRESS=admin@example.com
MAIL_INTERNAL_ORDERS_ADDRESS=pedidos@example.com

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Solo credenciales de prueba en local
MP_ENABLED=false
MP_ENABLED_TEST=true
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_TEST=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_NOTIFICATION_URL=
MP_CURRENCY_ID=ARS

# mail: SMS simulado en Mailpit (solo APP_ENV=local). Producción: twilio
SMS_DRIVER=mail
SMS_MAIL_TO=sms@armatrip.test
SMS_DEMO=false
TWILIO_TEST=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_ACCOUNT_SID_TEST=
TWILIO_AUTH_TOKEN_TEST=
TWILIO_NUMBER_TEST=

CAPTCHA_IS_ACTIVE=false
GOOGLE_RECAPTCHA_SECRET=
GOOGLE_API_KEY=

IMAP_HOST=
IMAP_PORT=993
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SEARCH_SUBJECT="ARMATRIP Landing FamTours"
