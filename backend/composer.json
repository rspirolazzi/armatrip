{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.1.3",
        "akaunting/setting": "^1.0",
        "barryvdh/laravel-dompdf": "^0.8.3",
        "cohensive/embed": "5.5.*",
        "doctrine/dbal": "^2.8",
        "fideloper/proxy": "~4.0",
        "guzzlehttp/guzzle": "^6.3",
        "infyomlabs/adminlte-templates": "5.6.x-dev",
        "infyomlabs/laravel-generator": "5.6.x-dev",
        "intervention/image": "^2.5",
        "jeroen-g/laravel-packager": "^2.1",
        "laravel/framework": "5.6.*",
        "laravel/tinker": "~1.0",
        "laravelcollective/html": "^5.6.0",
        "laraveles/spanish": "^1.0",
        "maatwebsite/excel": "^3.1",
        "mercadopago/sdk": "^0.5.6",
        "optix/media": "^0.2.3",
        "pusher/pusher-php-server": "^3.2",
        "rap2hpoutre/laravel-log-viewer": "^1.3",
        "recca0120/terminal": "^1.6",
        "rtconner/laravel-tagging": "~4.0",
        "spatie/laravel-permission": "^2.31",
        "twilio/sdk": "^5.24",
        "tymon/jwt-auth": "dev-develop",
        "webklex/laravel-imap": "^1.4"
    },
    "require-dev": {
        "filp/whoops": "~2.0",
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "~1.0",
        "nunomaduro/collision": "~2.0",
        "phpunit/phpunit": "~7.0",
        "symfony/thanks": "^1.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "Rspirolazzi\\MultiCompany\\": "packages/Rspirolazzi/MultiCompany/src",
            "Rspirolazzi\\InternalOrders\\": "packages/Rspirolazzi/InternalOrders/src",
            "Rspirolazzi\\Coupons\\": "packages/Rspirolazzi/Coupons/src",
            "Rspirolazzi\\Sms\\": "packages/Rspirolazzi/Sms/src",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rspirolazzi\\MultiCompany\\": "packages/Rspirolazzi/MultiCompany/src",
            "Rspirolazzi\\InternalOrders\\": "packages/Rspirolazzi/InternalOrders/src",
            "Rspirolazzi\\Coupons\\": "packages/Rspirolazzi/Coupons/src",
            "Rspirolazzi\\Sms\\": "packages/Rspirolazzi/Sms/src",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
