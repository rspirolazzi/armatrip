    "extra": {
        "laravel": {
            "providers": [
                "Rspirolazzi\\MultiCompany\\MultiCompanyServiceProvider"
            ],
            "aliases": {
                "MultiCompany": "Rspirolazzi\\MultiCompany\\Facades\\MultiCompany"
            }
        }
