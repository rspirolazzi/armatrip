    "extra": {
        "laravel": {
            "providers": [
                "Rspirolazzi\\Coupons\\CouponsServiceProvider"
            ],
            "aliases": {
                "Coupons": "Rspirolazzi\\Coupons\\Facades\\Coupons"
            }
        }
    }
