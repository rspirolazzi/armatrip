# Copiar a .env en el servidor. Nunca versionar .env.
# Dueño de las imágenes en ghcr.io, en minúsculas
IMAGE_OWNER=rspirolazzi
# "latest" o un tag "sha-xxxxxxx" para fijar o volver a una versión
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Puertos, publicados solo en 127.0.0.1
BACKEND_PORT=8085
FRONTEND_PORT=3085

DB_DATABASE=armatrip
DB_USERNAME=armatrip
DB_PASSWORD=
DB_ROOT_PASSWORD=
