# Copiar a backend.env en el servidor. Nunca versionar backend.env.
# La conexión a la base, APP_ENV y APP_DEBUG los define docker-compose.yml.
APP_NAME=Armatrip
# docker compose run --rm --no-deps armatrip-backend php artisan key:generate --show
APP_KEY=
# openssl rand -hex 32
JWT_SECRET=
# Solo para sembrar los usuarios iniciales del panel
SEED_USERS_PASSWORD=

# URLs públicas, sin "/" final
APP_URL=https://api.example.com
APP_URL_FIX_IMAGES=https://api.example.com
APP_URL_STORAGE_IMAGES=/storage
APP_WEB_URL=https://www.example.com/cotizador
# IPs del proxy HTTPS, o "*" si el puerto solo es accesible desde él
TRUSTED_PROXIES=*

# true: migra al arrancar el contenedor. Hacer copia de la base antes de activarlo.
AUTO_MIGRATE=false

LOG_CHANNEL=stack
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-responder@example.com
MAIL_FROM_NAME=Armatrip
MAIL_ADMIN_ADDRESS=admin@example.com
MAIL_INTERNAL_ORDERS_ADDRESS=pedidos@example.com

MP_ENABLED=false
MP_ENABLED_TEST=true
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_TEST=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_NOTIFICATION_URL=
MP_CURRENCY_ID=ARS

# El registro exige un código por SMS.
# Demo: mail + SMS_DEMO=true envía el código por email a SMS_MAIL_TO (requiere MAIL_*).
# Producción: twilio con credenciales reales y SMS_DEMO=false.
SMS_DRIVER=mail
SMS_DEMO=true
SMS_MAIL_TO=
TWILIO_TEST=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_ACCOUNT_SID_TEST=
TWILIO_AUTH_TOKEN_TEST=
TWILIO_NUMBER_TEST=

CAPTCHA_IS_ACTIVE=false
GOOGLE_RECAPTCHA_SECRET=
GOOGLE_API_KEY=

IMAP_HOST=
IMAP_PORT=993
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SEARCH_SUBJECT="ARMATRIP Landing FamTours"
