# Copiar a .env o ejecutar docker/preparar-entorno.ps1. Nunca versionar .env.
# La contraseña de DB debe coincidir con la de backend/.env.
DB_DATABASE=armatrip
DB_USERNAME=armatrip
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Puertos, publicados solo en 127.0.0.1
BACKEND_PORT=8085
FRONTEND_PORT=3085
MAIL_UI_PORT=8026

# Migrar y, si la base está vacía, sembrar al iniciar
AUTO_MIGRATE=true
