# Copiar a .env.local (ignorado por git).
# Todo REACT_APP_* queda visible en el navegador: solo claves públicas.
REACT_APP_NAME=Armatrip
REACT_APP_VERSION=$npm_package_version
REACT_APP_API_URL=http://localhost:8085/api/
REACT_APP_API_BASE_PATH=
REACT_APP_API_VERSION=
REACT_APP_API_MERCADOPAGO_KEY=
REACT_APP_API_GOOGLE_MAP_KEY=
REACT_APP_API_GOOGLE_RECAPTCHA_KEY=
REACT_APP_API_GOOGLE_ANALYTICS=
REACT_APP_FACEBOOK_APP_ID=
# Si quedan vacíos, la web no muestra el dato.
REACT_APP_CONTACT_EMAIL=
REACT_APP_CONTACT_PHONE=
REACT_APP_CONTACT_ADDRESS=
REACT_APP_AGENCY_LICENSE=
REACT_APP_FACEBOOK_URL=
REACT_APP_INSTAGRAM_URL=
PUBLIC_URL=
